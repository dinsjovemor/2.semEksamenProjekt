<Window x:Class="_2.semEksamenProjekt.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2.semEksamenProjekt"
        mc:Ignorable="d"
        Title="CreateUserWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="Username" Margin="10, 10"/>
            <TextBox x:Name="usernameTextbox" Margin="10, 10"/>
            <TextBlock Text="Password" Margin="10, 10"/>
            <TextBox x:Name="passwordTextbox" Margin="10, 10"/>
            <StackPanel>
                <Button x:Name='CreateUserButton' Content="Create User" Margin="10, 10" Click="CreateUserButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
